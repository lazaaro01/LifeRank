# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# This Prisma version's config does not support a separate directUrl, so a
# single DATABASE_URL is used everywhere:
# - Local dev / `prisma migrate`: use the DIRECT connection string (port 5432).
# - Vercel production runtime: use the POOLED connection string (port 6543,
#   ?pgbouncer=true) instead, set as a Vercel environment variable.
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Storage (foto de comprovação das atividades)
# ---------------------------------------------------------------------------
# URL do projeto (Settings > API). Pode ser pública, só identifica o projeto.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# Service Role Key (Settings > API) — NUNCA exponha no client, usada só em
# Server Actions para subir arquivos no bucket "activity-photos".
SUPABASE_SERVICE_ROLE_KEY="replace-me"

# ---------------------------------------------------------------------------
# Web Push (notificações push, incluindo PWA no iPhone)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-me"
VAPID_PRIVATE_KEY="replace-me"
VAPID_SUBJECT="mailto:seu-email@exemplo.com"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# ---------------------------------------------------------------------------
# Realtime (Pusher Channels)
# ---------------------------------------------------------------------------
PUSHER_APP_ID="replace-me"
PUSHER_SECRET="replace-me"
NEXT_PUBLIC_PUSHER_KEY="replace-me"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"
