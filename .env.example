# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# This Prisma version's config does not support a separate directUrl, so a
# single DATABASE_URL is used everywhere:
# - Local dev / `prisma migrate`: use the DIRECT connection string (port 5432).
# - Vercel production runtime: use the POOLED connection string (port 6543,
#   ?pgbouncer=true) instead, set as a Vercel environment variable.
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# ---------------------------------------------------------------------------
# Realtime (Pusher Channels)
# ---------------------------------------------------------------------------
PUSHER_APP_ID="replace-me"
PUSHER_SECRET="replace-me"
NEXT_PUBLIC_PUSHER_KEY="replace-me"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"
